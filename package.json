{
  "name": "kobblon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run pages:items && node scripts/publish-to-root.mjs",
    "pages:items": "node --env-file-if-exists=.env scripts/write-item-pages.mjs",
    "publish:site": "node scripts/publish-to-root.mjs",
    "k6:build": "node tools/k6/build-k6.mjs",
    "k6:look": "vite --config vite.k6.config.mjs",
    "engine:dev": "vite --config vite.engine.config.mjs",
    "engine:check": "node tools/engine/drive.mjs",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/three": "^0.186.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
